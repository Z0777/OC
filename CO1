       varVistaArea = "Consulta"; "Vista de consulta";
       "Pendientes de " & varVistaNombre & " · " & frAreaVista);;

frIndicadores =
    With(
        {
            nAl: CountIf(frOrdenes; Nivel = "crit");
            rf: Filter(frOrdenes; HRec And HFac);
            f1: Filter(frOrdenes; HFac And H101)
        };
        Table(
            {Nombre: "Órdenes con alerta"; Valor: Text(nAl); Critico: nAl > 0};
