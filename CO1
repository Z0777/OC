**btnGuardarPO › OnSelect**

```powerfx
Set(varGuardando; true);;
With(
    {
        po: Trim(txtPO.Text);
        prov: Trim(If(varModoProv = "lista"; cmbProveedor.Selected.Value; txtProveedor.Text));
        cred: Coalesce(Value(txtDiasCredito.Text); frDiasCredito)
    };
    If(
        varModoPO = "nueva" And IsBlank(po); Set(varErrPO; "Escribe el número de PO.");
        IsBlank(prov); Set(varErrPO; "Indica el proveedor.");
        IsBlank(Trim(txtDescripcion.Text)); Set(varErrPO; "Escribe la descripción.");
        varModoPO = "nueva" And !IsBlank(LookUp(TRZ_OrdenesCompra; Title = po)); Set(varErrPO; "La PO " & po & " ya está registrada. Búscala en Órdenes de compra.");

        // ---------- NUEVA PO ----------
        varModoPO = "nueva";
            Set(varErrPO; "");;
            Set(varRes; Patch(TRZ_OrdenesCompra; Defaults(TRZ_OrdenesCompra);
                {
                    Title: po;
                    Proveedor: prov;
                    Descripcion: Trim(txtDescripcion.Text);
                    Cantidad: Trim(txtCantidad.Text);
                    PdfUrl: Trim(txtPdf.Text);
                    DiasCredito: cred;
                    FechaSolicitud: Coalesce(dpFechaSolicitud.SelectedDate; varHoy);
                    SolicitadoPor: User().FullName;
                    Llamadas: 0;
                    Rechazos: 0;
                    Etapa: "Solicitada";
                    Cerrada: 0;
                    UltimoMovimiento: Now()
                }
            ));;
            If(
                IsEmpty(Errors(TRZ_OrdenesCompra));
                    Collect(colOrdenes; varRes);;
                    Patch(TRZ_HistorialPO; Defaults(TRZ_HistorialPO); frFirma;
                        {
                            Title: po; OrdenID: varRes.ID; Tipo: "Solicitud"; FechaEvento: varRes.FechaSolicitud;
                            Detalle: "PO registrada con estatus Solicitado" &
                                If(IsBlank(varRes.Cantidad); ""; " · " & varRes.Cantidad) &
                                If(IsBlank(varRes.PdfUrl); ""; " · PDF adjunto")
                        }
                    );;
                    If(IsBlank(LookUp(colProveedores; Lower(Title) = Lower(prov)));
                        Collect(colProveedores; Patch(TRZ_Proveedores; Defaults(TRZ_Proveedores); {Title: prov; Activo: true}))
                    );;
                    Set(varPOId; varRes.ID);;
                    ClearCollect(colHist; Sort(Filter(TRZ_HistorialPO; OrdenID = varPOId); ID; SortOrder.Descending));;
                    Set(varAccion; "");;
                    Set(varChip; "pendientes");;
                    Set(varEtapaFiltro; "Todas");;
                    Set(varModalPO; false);;
                    Set(varTab; "ordenes");;
                    Notify("PO " & po & " registrada como Solicitada."; NotificationType.Success);
                Notify("No se guardó la PO: " & First(Errors(TRZ_OrdenesCompra)).Message; NotificationType.Error)
            );

        // ---------- EDITAR PO ----------
        Set(varPOAct; LookUp(TRZ_OrdenesCompra; ID = varPOId));;
        Set(varCambios;
            Concat(
                Filter(
                    Table(
                        {C: "Proveedor"; A: varPOAct.Proveedor; B: prov};
                        {C: "Descripción"; A: varPOAct.Descripcion; B: Trim(txtDescripcion.Text)};
                        {C: "Cantidad"; A: varPOAct.Cantidad; B: Trim(txtCantidad.Text)};
                        {C: "PDF"; A: varPOAct.PdfUrl; B: Trim(txtPdf.Text)};
                        {C: "Días de crédito"; A: Text(varPOAct.DiasCredito); B: Text(cred)}
                    );
                    Coalesce(A; "") <> Coalesce(B; "")
                );
                C & ": " & Coalesce(A; "—") & " → " & Coalesce(B; "—");
                "  ·  "
            )
        );;
        If(
            IsBlank(varCambios); Set(varErrPO; "No hay cambios que guardar.");
            !IsBlank(varPOAct.FechaPago); Set(varErrPO; "La PO ya está pagada y no se puede editar.");
            Set(varRes; Patch(TRZ_OrdenesCompra; varPOAct;
                {
                    Proveedor: prov;
                    Descripcion: Trim(txtDescripcion.Text);
                    Cantidad: Trim(txtCantidad.Text);
                    PdfUrl: Trim(txtPdf.Text);
                    DiasCredito: cred;
                    FechaPagoEstimada: If(!IsBlank(varPOAct.Fecha101) And !IsBlank(varPOAct.FechaFactura);
                        DateAdd(varPOAct.Fecha101; cred; TimeUnit.Days); varPOAct.FechaPagoEstimada);
                    UltimoMovimiento: Now()
                }
            ));;
            If(
                IsEmpty(Errors(TRZ_OrdenesCompra));
                    Patch(TRZ_HistorialPO; Defaults(TRZ_HistorialPO); frFirma;
                        {Title: varPOAct.Title; OrdenID: varPOId; Tipo: "Edición"; FechaEvento: varHoy; Detalle: varCambios}
                    );;
                    If(IsBlank(LookUp(colProveedores; Lower(Title) = Lower(prov)));
                        Collect(colProveedores; Patch(TRZ_Proveedores; Defaults(TRZ_Proveedores); {Title: prov; Activo: true}))
                    );;
                    Patch(colOrdenes; LookUp(colOrdenes; ID = varPOId); varRes);;
                    ClearCollect(colHist; Sort(Filter(TRZ_HistorialPO; OrdenID = varPOId); ID; SortOrder.Descending));;
                    Set(varErrPO; "");;
                    Set(varModalPO; false);;
                    Notify("Datos de la PO actualizados."; NotificationType.Success);
                Notify("No se guardó: " & First(Errors(TRZ_OrdenesCompra)).Message; NotificationType.Error)
            )
        )
    )
);;
Set(varGuardando; false)
