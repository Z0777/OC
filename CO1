frCola =
    SortByColumns(
        Filter(frOrdenes; Etapa <> "Pagada" And Resp <> "Proveedor" And Resp <> "" And (varVistaArea = "Admin" Or Resp = varVistaArea));
        "NivelOrden"; SortOrder.Ascending;
        "Dias"; SortOrder.Descending
    );;

